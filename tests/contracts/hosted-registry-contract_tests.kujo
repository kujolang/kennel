test "hosted auth token store supports set/get/clear lifecycle" {
	store_path := "/tmp/kennel-auth-token-store-test.json"
	execute_status("rm -f '" + store_path + "'")

	set_result := auth_token_store("set", {
		"store_path": store_path,
		"registry": "local-hosted",
		"user": "alice",
		"token": "token-alice-123"
	})
	assert_equal(set_result["ok"], true)
	assert_equal(set_result["store_path"], store_path)

	permissions_result := execute_status("ls -l '" + store_path + "'")
	assert_equal(permissions_result.success, true)
	assert_true(index_of(to_string(permissions_result.stdout), "rw-------") >= 0)

	get_result := auth_token_store("get", {
		"store_path": store_path,
		"registry": "local-hosted",
		"user": "alice"
	})
	assert_equal(get_result["ok"], true)
	assert_equal(get_result["token"], "token-alice-123")

	list_result := auth_token_store("list", {
		"store_path": store_path
	})
	assert_equal(list_result["ok"], true)
	assert_true(len(list_result["entries"]) >= 1)

	clear_result := auth_token_store("clear", {
		"store_path": store_path,
		"registry": "local-hosted",
		"user": "alice"
	})
	assert_equal(clear_result["ok"], true)

	get_after_clear := auth_token_store("get", {
		"store_path": store_path,
		"registry": "local-hosted",
		"user": "alice"
	})
	assert_equal(get_after_clear["ok"], false)

	execute_status("rm -f '" + store_path + "'")
}

test "hosted auth token store uses stable default path instead of cwd token file" {
	resolved_default := token_store_path({})
	assert_true(ends_with(resolved_default, "/.kennel/tokens.json"))

	cwd_result := execute_status("pwd")
	assert_equal(cwd_result.success, true)
	cwd_path := trim(to_string(cwd_result.stdout))
	assert_true(resolved_default != cwd_path + "/.kennel_tokens.json")
}

test "hosted publish writes index and package metadata artifacts" {
	project_dir := "/tmp/kennel-publish-contract"
	registry_dir := project_dir + "/registry"
	execute_status("rm -rf '" + project_dir + "'")
	execute_status("mkdir -p '" + project_dir + "'")

	manifest_obj := default_manifest("publish-demo")
	manifest_package := manifest_obj["package"]
	manifest_package["version"] := "1.2.3"
	manifest_package["description"] := "Publish contract fixture"
	manifest_obj["package"] := manifest_package
	manifest_obj["trust"] := {
		"checksum": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
		"signature": "cHVibGlzaC1kZW1vLTEyMw==",
		"signing_key": "key.publish-demo-123"
	}

	publish_result := publish_package(project_dir, {
		"manifest": manifest_obj,
		"registry": "hosted-registry",
		"user": "alice",
		"token": "token-publish-123",
		"registry_dir": registry_dir
	})
	assert_equal(publish_result["ok"], true)
	assert_true(file_exists(registry_dir + "/index.json"))
	assert_true(file_exists(registry_dir + "/packages/publish-demo.json"))

	index_doc := parse_json(read_file(registry_dir + "/index.json"))
	assert_equal(len(index_doc["packages"]), 1)
	assert_equal(index_doc["packages"][0]["name"], "publish-demo")
	assert_equal(index_doc["packages"][0]["latest"], "1.2.3")
	assert_equal(index_doc["packages"][0]["versions"][0]["checksum"], "sha256:2222222222222222222222222222222222222222222222222222222222222222")
	assert_equal(index_doc["packages"][0]["versions"][0]["signature"], "cHVibGlzaC1kZW1vLTEyMw==")
	assert_equal(index_doc["packages"][0]["versions"][0]["signing_key"], "key.publish-demo-123")

	metadata_doc := parse_json(read_file(registry_dir + "/packages/publish-demo.json"))
	assert_equal(metadata_doc["name"], "publish-demo")
	assert_equal(metadata_doc["latest"], "1.2.3")
	assert_equal(len(metadata_doc["versions"]), 1)
	assert_equal(metadata_doc["versions"][0]["checksum"], "sha256:2222222222222222222222222222222222222222222222222222222222222222")
	assert_equal(metadata_doc["versions"][0]["signature"], "cHVibGlzaC1kZW1vLTEyMw==")
	assert_equal(metadata_doc["versions"][0]["signing_key"], "key.publish-demo-123")

	duplicate_publish := publish_package(project_dir, {
		"manifest": manifest_obj,
		"registry": "hosted-registry",
		"user": "alice",
		"token": "token-publish-123",
		"registry_dir": registry_dir
	})
	assert_equal(duplicate_publish["ok"], false)
	assert_true(index_of(to_string(duplicate_publish["error"]), "already contains version") >= 0)

	manifest_v2 := default_manifest("publish-demo")
	manifest_v2_package := manifest_v2["package"]
	manifest_v2_package["version"] := "1.2.4"
	manifest_v2["package"] := manifest_v2_package
	non_owner_publish := publish_package(project_dir, {
		"manifest": manifest_v2,
		"registry": "hosted-registry",
		"user": "bob",
		"token": "token-publish-bob",
		"registry_dir": registry_dir
	})
	assert_equal(non_owner_publish["ok"], false)
	assert_true(index_of(to_string(non_owner_publish["error"]), "Only package owners can publish new versions") >= 0)

	execute_status("rm -rf '" + project_dir + "'")
}

test "hosted publish safely handles quoted registry_dir paths" {
	project_dir := "/tmp/kennel-publish-quoted-registry"
