# Preserve module environments in the standalone bootstrap; flattening functions
# changes Kujo name resolution when archive helpers share caller variable names.
from src.utils import ensure_dir
params := args()
if len(params) != 2 { throw("Usage: bundle_installer.kujo SOURCE_ROOT OUTPUT") }
mut installer_modules := {}
for module in ["src/utils.kujo", "src/semver.kujo", "src/registry_transport.kujo", "src/registry_protocol.kujo", "src/registry_archive.kujo", "src/global_common.kujo", "src/bootstrap.kujo", "scripts/install.kujo"] {
    installer_modules[module] = split(read_file(params[0] + "/" + module), "\n")
}
mut output := "# Generated Kennel native installer. Modules retain their reviewed import boundaries.\ninstaller_modules := " + to_json(installer_modules) + "\n"
output = output + read_file(params[0] + "/scripts/registry/site/install-runner.kujo.template")
ensure_dir(dirname(params[1]))
write_file_atomic(params[1], output, true)
print("Generated native installer: " + params[1])
