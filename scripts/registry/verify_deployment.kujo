from src.registry_transport import registry_get

func comparable_text(body) {
    return replace(replace(body, "<!--email_off-->", ""), "<!--/email_off-->", "")
}

mut root := args()[0]
mut origin := "https://kennel.kujolang.ai/"
mut documents := [
    ["api/v1/index.json", "api/v1/index.json"],
    ["", "index.html"],
    ["getting-started/", "getting-started/index.html"],
    ["sitemap.xml", "sitemap.xml"]
]
mut expected := {}
for document in documents { expected[document[0]] := comparable_text(read_file(root + "/" + document[1])) }
mut verified := {}
mut attempt := 0
while attempt < 40 {
    try {
        for document in documents {
            mut route := document[0]
            if comparable_text(registry_get(origin + route, 1048576)["body"]) != expected[route] { throw("Deployment has not caught up: /" + route) }
        }
        for name in list_dir(root + "/packages") {
            for version in list_dir(root + "/packages/" + name) {
                mut manifest := json_file_read(root + "/packages/" + name + "/" + version + "/manifest.json", 1048576)
                mut url := manifest["archive_url"]
                mut expected_digest := manifest["archive_sha256"]
                if has_key(verified, url) && verified[url] == expected_digest { continue }
                if sha256(registry_get(url, 8388608)["_body_bytes"]) != expected_digest { throw("Deployed artifact digest mismatch: " + url) }
                verified[url] := expected_digest
            }
        }
        print("Production discovery, landing pages, sitemap, and all immutable archive digests verified"); break
    } except err { if attempt == 39 { throw(err) }; print("Waiting for Pages: " + to_string(err)); sleep(15000) }
    attempt = attempt + 1
}
