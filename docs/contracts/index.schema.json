{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujolang.github.io/kennel/schemas/index.schema.json",
  "title": "Kennel Static Registry Index",
  "description": "Stage 2 contract for index.json used by name-based package discovery.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "packages"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "description": "RFC3339 timestamp when the index was generated."
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "latest",
          "metadata_path",
          "versions"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "latest": {
            "type": "string",
            "minLength": 1
          },
          "metadata_path": {
            "type": "string",
            "pattern": "^packages/.+\\.json$"
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "source",
                "ref"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "description": "Canonical dependency source string consumable by kennel add/install."
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "checksum": {
                  "type": "string",
                  "minLength": 1
                },
                "yanked": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
