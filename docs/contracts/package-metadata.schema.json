{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujolang.github.io/kennel/schemas/package-metadata.schema.json",
  "title": "Kennel Package Metadata",
  "description": "Stage 2 contract for packages/<name>.json metadata documents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "latest",
    "repository",
    "versions"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "latest": {
      "type": "string",
      "minLength": 1
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "source",
          "ref"
        ],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "checksum": {
            "type": "string",
            "minLength": 1
          },
          "published_at": {
            "type": "string"
          },
          "yanked": {
            "type": "boolean"
          },
          "deprecation": {
            "type": "string"
          }
        }
      }
    }
  }
}
