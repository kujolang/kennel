#!/bin/sh
set -eu
KENNEL_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export KUJO_MODULE_PATH="$KENNEL_ROOT"
export KUJO_ISOLATED_IMPORTS=1
if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-V" ]; then
    exec "${KUJO_BIN:-kujo}" run "$KENNEL_ROOT/scripts/tool_metadata.kujo" --interpreter --isolated-imports -- --version "$KENNEL_ROOT/kennel.toml"
fi
if [ "${1:-}" = "self" ] && [ "${2:-}" = "update" ]; then
    shift 2
    exec "${KUJO_BIN:-kujo}" run "$KENNEL_ROOT/scripts/install.kujo" --interpreter --isolated-imports -- --no-modify-path "$@"
fi
if [ "${1:-}" = "tool" ]; then
    shift
    exec "${KUJO_BIN:-kujo}" run "$KENNEL_ROOT/scripts/tool_manager.kujo" --interpreter --isolated-imports -- "$@"
fi
exec "${KUJO_BIN:-kujo}" run "$KENNEL_ROOT/kennel.kujo" --interpreter --isolated-imports -- "$@"
