from src.global_common import global_link, global_present, global_no_links, global_directory, global_home, global_delete, global_capture, global_which, global_runtime, global_name, global_owned, global_options, global_contains
from src.utils import dict_get_or, shell_quote
from src.semver import parse_semver_value, compare_semver

export func tool_state(base) {
    if global_present(base + "/tools.json") == false { return {"schema_version": 1, "packages": {}} }
    global_no_links(base + "/tools.json")
    mut data := json_file_read(base + "/tools.json", 8388608)
    if type(data) != "dict" || dict_get_or(data, "schema_version", 0) != 1 || type(dict_get_or(data, "packages", null)) != "dict" { throw("Unsupported or invalid global tool state") }
    return data
}
func tool_save(base, state) {
    write_file_atomic(base + "/tools.json", to_json(state) + "\n", true)
    io_set_permissions(base + "/tools.json", 384)
}
export func tool_shim(base, command) { return "#!/bin/sh\n# Kennel managed tool command\nexec " + shell_quote(base + "/bin/kennel") + " tool run --command " + shell_quote(command) + " -- \"$@\"\n" }
export func tool_entry(package, entry) {
    if type(entry) != "string" || entry == "" || starts_with(entry, "/") || index_of(entry, "\\") >= 0 { throw("Invalid tool entry path: " + to_json(entry)) }
    for ch in split(entry, "") { if ch != "" && ch < " " { throw("Invalid tool entry path: " + to_json(entry)) } }
    for part in split(entry, "/") { if part == ".." { throw("Tool entries must be relative packaged files without traversal") } }
    mut target := package + "/" + entry
    global_no_links(target)
    if path_is_file(target) == false { throw("Tool entry must be a regular packaged file: " + entry) }
    if ends_with(target, ".kujo") { return [global_runtime(), "run", target, "--interpreter", "--isolated-imports", "--"] }
    mut line := split(decode_charset(io_read_at(target, 0, min(256, file_size(target))), "utf-8", 256), "\n")[0]
    line = trim(line)
    mut supported := {"#!/bin/sh": "/bin/sh", "#!/usr/bin/env sh": "/bin/sh", "#!/bin/bash": "/bin/bash", "#!/usr/bin/env bash": "/bin/bash", "#!/usr/bin/env python3": "python3", "#!/usr/bin/python3": "python3"}
    mut interpreter := dict_get_or(supported, line, "")
    if interpreter == "python3" { interpreter = global_which(interpreter) }
    if interpreter == "" || bit_and(io_file_metadata(target)["mode"], 73) == 0 { throw("Entry must be .kujo or an executable sh/bash/python3 script with a supported shebang") }
    return [interpreter, target]
}
export func tool_commands(package, manifest, command) {
    mut declared := dict_get_or(manifest, "bin", null)
    if declared == null {
        mut entry := dict_get_or(dict_get_or(manifest, "kujo", {}), "entry", "")
        if entry == "" { throw("Package has no executable entry; use kennel add for libraries") }
        mut name := manifest["package"]["name"]
        if command != "" { name = command }
        declared = {}; declared[name] = entry
    } else if command != "" {
        if type(declared) != "dict" || len(keys(declared)) != 1 { throw("--command requires a single executable") }
        mut entry := declared[keys(declared)[0]]; declared = {}; declared[command] = entry
    }
    if type(declared) != "dict" || len(keys(declared)) == 0 { throw("[bin] must map command names to entry files") }
    for name in keys(declared) {
        if global_name(name) == false || global_contains(["kennel", "kujo", "sh", "bash", "zsh", "fish", "python", "python3", "env"], name) { throw("Unsafe or reserved global command: " + name) }
        tool_entry(package, declared[name])
    }
    return declared
}
export func tool_activate(base, state, name, record, allow_shadow) {
    mut bindir := global_directory(base + "/bin")
    for command in keys(record["commands"]) {
        mut target := bindir + "/" + command
        for other in keys(state["packages"]) {
            if other != name && has_key(state["packages"][other]["commands"], command) { throw("Command " + command + " belongs to " + other) }
        }
        if global_present(target) && global_owned(target, tool_shim(base, command)) == false { throw("Refusing to overwrite existing command: " + target) }
        mut existing := global_which(command)
        if existing != "" && existing != target && allow_shadow == false { throw("Command " + command + " already exists on PATH; use --allow-shadow to opt in") }
    }
    mut old := dict_get_or(state["packages"], name, {"commands": {}})
    mut created := []
    try {
        for command in keys(record["commands"]) {
            mut target := bindir + "/" + command
            if global_present(target) == false { write_file(target, tool_shim(base, command)); created = push(created, target); io_set_permissions(target, 493) }
        }
        mut packages := state["packages"]; packages[name] = record; state["packages"] = packages
        tool_save(base, state)
    } except err { for path in created { delete_file(path) }; throw(err) }
    for command in keys(old["commands"]) {
        mut path := bindir + "/" + command
        if has_key(record["commands"], command) == 0 && global_owned(path, tool_shim(base, command)) { delete_file(path) }
    }
}
func tool_native(root, argv) { return global_capture(concat([global_runtime(), "run", root + "/kennel.kujo", "--interpreter", "--isolated-imports", "--"], argv), {"KUJO_MODULE_PATH": root, "KUJO_ISOLATED_IMPORTS": "1"}) }
func tool_install(root, base, spec, command, shadow) {
    if starts_with(spec, "file:") { mut source_path := substring(spec, 5, len(spec)); if starts_with(source_path, "~/") { source_path = env("HOME") + substring(source_path, 1, len(source_path)) }; spec = "file:" + path_absolute(source_path)
    } else if starts_with(spec, ".") || starts_with(spec, "/") { spec = "file:" + path_absolute(spec) }
    mut stage := create_temp_dir(global_directory(base + "/tools"), "generation-")
    try {
        tool_native(root, ["init", "--name", "kennel-global-tool", "--project-dir", stage])
        mut output := tool_native(root, ["add", spec, "--project-dir", stage]); print(trim(output))
        mut lock := parse_toml(read_file(stage + "/kennel.lock"))
        mut manifest := parse_toml(read_file(stage + "/kennel.toml"))
        mut names := keys(dict_get_or(manifest, "dependencies", {}))
        if len(names) != 1 || global_name(names[0]) == false { throw("Expected exactly one safe top-level tool package") }
        mut name := names[0]; mut package := stage + "/kennel_packages/" + name
        mut source := parse_toml(read_file(package + "/kennel.toml"))
        mut minimum := dict_get_or(dict_get_or(source, "kujo", {}), "minimum_version", "1.3.1")
        if minimum == "" { minimum = "1.3.1" }
        mut required := parse_semver_value(minimum)
        mut installed := parse_semver_value(trim(replace(global_capture([global_runtime(), "--version"], {}), "kujo ", "")))
        if required["ok"] == false || installed["ok"] == false || compare_semver(installed, required) < 0 { throw("Tool requires Kujo " + minimum + " or newer") }
        mut commands := tool_commands(package, source, command)
        mut roots := [package]; mut selected := null
        for entry in lock["package"] {
            mut parts := split(entry["install_path"], "/")
            if len(parts) != 2 || parts[0] != "kennel_packages" || global_name(parts[1]) == false { throw("Invalid locked tool dependency path") }
            if entry["name"] == name { selected = entry } else { roots = push(roots, stage + "/" + entry["install_path"]) }
        }
        if selected == null { throw("Missing tool lock entry") }
        mut record := {"spec": spec, "version": source["package"]["version"], "generation": basename(stage), "commands": commands, "command_override": command, "module_roots": roots, "lock": selected}
        tool_activate(base, tool_state(base), name, record, shadow)
        print("Installed " + name + " " + record["version"] + ": " + join(sort(keys(commands)), ", "))
    } except err { global_delete(stage); throw(err) }
}
export func global_tools_main(root, argv) {
    if len(argv) == 0 || argv[0] == "--help" || argv[0] == "-h" { print("Usage: kennel tool install|update|list|remove|run [package] [--command NAME] [--allow-shadow]"); return }
    mut action := argv[0]; mut rest := slice(argv, 1, len(argv)); mut base := global_home("")
    if action == "run" {
        if len(rest) < 2 || rest[0] != "--command" { throw("tool run requires --command NAME") }
        mut command := rest[1]; mut arguments := slice(rest, 2, len(rest))
        if len(arguments) > 0 && arguments[0] == "--" { arguments = slice(arguments, 1, len(arguments)) }
        mut state := tool_state(base)
        for name in keys(state["packages"]) {
            mut record := state["packages"][name]
            if has_key(record["commands"], command) {
                if global_name(name) == false || starts_with(record["generation"], "generation-") == false || index_of(record["generation"], "/") >= 0 { throw("Invalid tool generation") }
                mut package := base + "/tools/" + record["generation"] + "/kennel_packages/" + name
                mut invocation := tool_entry(package, record["commands"][command])
                exec_process(concat(invocation, arguments), {"env": {"KUJO_MODULE_PATH": join(record["module_roots"], ":"), "KUJO_ISOLATED_IMPORTS": "1", "KUJO_BIN": global_runtime()}, "env_deny": ["KUJO_SCRIPT_ARGS_JSON", "KUJO_SCRIPT_ARGS"]})
            }
        }
        throw("Global command is not installed: " + command)
    }
    mut parsed := global_options(rest, ["--command"], ["--allow-shadow"])
    mut names := parsed["positional"]; mut command := dict_get_or(parsed, "--command", ""); mut shadow := dict_get_or(parsed, "--allow-shadow", false)
    mut token := file_lock(base + "/.tools.lock", 180000)
    try {
        mut state := tool_state(base)
        if action == "list" {
            if len(names) != 0 { throw("tool list takes no package") }
            for name in sort(keys(state["packages"])) { mut record := state["packages"][name]; print(name + " " + record["version"] + "  " + join(sort(keys(record["commands"])), ", ")) }
        } else if action == "install" {
            if len(names) != 1 { throw("tool install requires one package") }
            tool_install(root, base, names[0], command, shadow)
        } else if action == "update" {
            if len(names) > 1 { throw("tool update accepts one package") }
            if len(names) == 0 { names = sort(keys(state["packages"])) }
            for name in names {
                if has_key(state["packages"], name) == 0 { throw("Tool not installed; use kennel tool install PACKAGE@VERSION to select a version") }
                mut record := state["packages"][name]; mut override := command
                if override == "" { override = dict_get_or(record, "command_override", ""); if override == null { override = "" } }
                tool_install(root, base, record["spec"], override, shadow)
            }
        } else if action == "remove" {
            if len(names) != 1 || has_key(state["packages"], names[0]) == 0 { throw("Tool not installed") }
            mut name := names[0]; mut record := state["packages"][name]; mut packages := {}
            for key in keys(state["packages"]) { if key != name { packages[key] = state["packages"][key] } }
            state["packages"] = packages; tool_save(base, state)
            for cmd in keys(record["commands"]) { mut path := base + "/bin/" + cmd; if global_owned(path, tool_shim(base, cmd)) { delete_file(path) } }
            print("Removed " + name)
        } else { throw("Unknown tool command: " + action) }
    } except err { file_unlock(token); throw(err) }
    file_unlock(token)
}
