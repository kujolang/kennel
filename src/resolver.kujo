from src.registry_protocol import registry_resolve_spec
from src.utils import command_ok, dict_get_or, run_shell, shell_quote

from src.semver import parse_semver_value, compare_semver, semver_satisfies_range

func git_ls_remote_tags(url) {
	cmd := "git ls-remote --tags --refs " + shell_quote(url)
	result := run_shell(cmd)
	if command_ok(result) == false {
		return {
			"ok": false,
			"error": "Failed to list tags from " + url + ": " + trim(to_string(result.stderr))
		}
	}
	lines := split(trim(to_string(result.stdout)), "\n")
	tags := []
	for line in lines {
		trimmed_line := trim(to_string(line))
		if trimmed_line == "" {
			continue
		}
		parts := split(trimmed_line, "\t")
		if len(parts) < 2 {
			continue
		}
		commit := trim(to_string(parts[0]))
		ref_name := trim(to_string(parts[1]))
		if starts_with(ref_name, "refs/tags/") {
			tags := push(tags, {
				"tag": substring(ref_name, len("refs/tags/"), len(ref_name)),
				"commit": commit
			})
		}
	}
	if len(tags) == 0 {
		return {
			"ok": false,
			"error": "No tags were found in " + url + " for semver range resolution."
		}
	}
	return {
		"ok": true,
		"tags": tags
	}
}

func resolve_semver_range(url, range_expr) {
	tags_result := git_ls_remote_tags(url)
	if tags_result["ok"] == false {
		return tags_result
	}
	best_found := false
	best_version := {}
	best_tag := ""
	best_commit := ""
	for tag_entry in tags_result["tags"] {
		tag_name := to_string(dict_get_or(tag_entry, "tag", ""))
		parsed_version := parse_semver_value(tag_name)
		if parsed_version["ok"] && semver_satisfies_range(parsed_version, range_expr) {
			if best_found == false || compare_semver(parsed_version, best_version) > 0 {
				best_found = true
				best_version = parsed_version
				best_tag = tag_name
				best_commit = to_string(dict_get_or(tag_entry, "commit", ""))
			}
		}
	}
	if best_found == false {
		return {
			"ok": false,
			"error": "No tag in " + url + " satisfied semver range `" + range_expr + "`."
		}
	}
	return {
		"ok": true,
		"tag": best_tag,
		"commit": best_commit,
		"version": to_string(dict_get_or(best_version, "normalized", ""))
	}
}

func format_git_ls_remote_error(url, selector, stderr_text) {
	stderr_value := trim(stderr_text)
	if stderr_value == "" {
		return "Failed to resolve ref `" + selector + "` from " + url + ". Git returned no stderr output. Verify network access and repository visibility."
	}
	if index_of(stderr_value, "Repository not found") >= 0 || index_of(stderr_value, "repository not found") >= 0 {
		return "Failed to resolve ref `" + selector + "` from " + url + ". Repository not found. Verify owner/repo and repository visibility (public/private access)."
	}
	return "Failed to resolve ref `" + selector + "` from " + url + ". " + stderr_value + " Verify that the repository is reachable and that the requested ref exists."
}

func git_ls_remote(url, ref_name) {
	selector := trim(ref_name)
	if selector == "" {
		selector := "HEAD"
	}
	cmd := "git ls-remote " + shell_quote(url) + " " + shell_quote(selector)
	result := run_shell(cmd)
	if command_ok(result) == false {
		return {
			"ok": false,
			"error": format_git_ls_remote_error(url, selector, result.stderr)
		}
	}
	lines := split(trim(result.stdout), "\n")
	if len(lines) == 0 || trim(lines[0]) == "" {
		return {
			"ok": false,
			"error": "No commit found for ref `" + selector + "` in " + url + ". Verify that the ref exists and is pushed to the remote repository."
		}
	}
	first := trim(lines[0])
	parts := split(first, "\t")
	if len(parts) < 1 {
		return {
			"ok": false,
			"error": "Could not parse git ls-remote output for " + url
		}
	}
	commit := trim(parts[0])
	if commit == "" {
		return {
			"ok": false,
			"error": "Resolved commit was empty for " + url
		}
	}
	return {
		"ok": true,
		"commit": commit,
		"ref": selector
	}
}

func resolve_dependency_with_policy(dep_name, parsed_spec, resolution_policy) {
	spec := parsed_spec
	if dict_get_or(spec, "kind", "") == "registry" {
		try {
			return {"ok": true, "resolved": registry_resolve_spec(dep_name, spec)}
		} except err {
			return {"ok": false, "error": to_string(err)}
		}
	}
	kind := dict_get_or(spec, "kind", "")
	requested := trim(to_string(dict_get_or(spec, "requested", "")))
	requested_kind := to_string(dict_get_or(spec, "requested_kind", "none"))
	allow_semver_ranges := false
	if type(resolution_policy) == "dict" {
		allow_semver_ranges = dict_get_or(resolution_policy, "semver_ranges", false) == true
	}

	resolved := {
		"name": dep_name,
		"kind": kind,
		"source": dict_get_or(spec, "source", ""),
		"requested": requested,
		"requested_kind": requested_kind,
		"resolved_ref": "",
		"resolved_commit": "",
		"url": dict_get_or(spec, "url", ""),
		"path": dict_get_or(spec, "path", ""),
		"checksum": trim(to_string(dict_get_or(spec, "checksum", ""))),
		"signature": trim(to_string(dict_get_or(spec, "signature", ""))),
		"signing_key": trim(to_string(dict_get_or(spec, "signing_key", "")))
	}

	if kind == "path" {
		resolved["resolved_ref"] := "local"
		resolved["resolved_commit"] := ""
		return {
			"ok": true,
			"resolved": resolved
		}
	}

	if requested_kind == "commit" {
		resolved["resolved_ref"] := requested
		resolved["resolved_commit"] := requested
		return {
			"ok": true,
			"resolved": resolved
		}
	}

	if allow_semver_ranges && requested_kind == "range" {
		range_result := resolve_semver_range(resolved["url"], requested)
		if range_result["ok"] == false {
			return range_result
		}
		resolved["resolved_ref"] := to_string(dict_get_or(range_result, "tag", ""))
		resolved["resolved_commit"] := ""
		resolved["resolved_version"] := to_string(dict_get_or(range_result, "version", ""))
		return {
			"ok": true,
			"resolved": resolved
		}
	}

	selector := requested
	if selector == "" {
		selector := "HEAD"
	}
	git_result := git_ls_remote(resolved["url"], selector)
	if git_result["ok"] == false {
		return git_result
	}
	resolved["resolved_ref"] := selector
	resolved["resolved_commit"] := git_result["commit"]
	return {
		"ok": true,
		"resolved": resolved
	}
}

func resolve_dependency(dep_name, parsed_spec) {
	return resolve_dependency_with_policy(dep_name, parsed_spec, {})
}

func lock_entry_from_install(install_result) {
	resolved := install_result["resolved"]
	entry := {
		"name": resolved["name"],
		"version": dict_get_or(install_result, "version", "0.0.0"),
		"source": resolved["source"],
		"requested": resolved["requested"],
		"requested_kind": resolved["requested_kind"],
		"resolved_ref": resolved["resolved_ref"],
		"resolved_commit": resolved["resolved_commit"],
		"install_path": dict_get_or(install_result, "install_path", ""),
		"checksum": trim(to_string(dict_get_or(install_result, "checksum", dict_get_or(resolved, "checksum", "")))),
		"signature": trim(to_string(dict_get_or(install_result, "signature", dict_get_or(resolved, "signature", "")))),
		"signing_key": trim(to_string(dict_get_or(install_result, "signing_key", dict_get_or(resolved, "signing_key", "")))),
		"repository": dict_get_or(install_result, "repository", dict_get_or(resolved, "url", "")),
		"kind": resolved["kind"],
		"path": dict_get_or(resolved, "path", "")
	}
	if resolved["kind"] == "registry" {
		for key in ["registry", "registry_manifest", "package_identity", "provenance_status"] {
			entry[key] := resolved[key]
		}
	}
	return entry
}

export resolve_dependency := resolve_dependency
export resolve_dependency_with_policy := resolve_dependency_with_policy
export lock_entry_from_install := lock_entry_from_install
export format_git_ls_remote_error := format_git_ls_remote_error
